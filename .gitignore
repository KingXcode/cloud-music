# .vscode 文件夹包含在 VS Code 中配置的启动项和任务，
# 这些内容可能需要纳入版本控制，
# 因此默认将下方忽略规则注释掉。
#.vscode/

# Flutter/Dart/Pub 相关文件
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# 符号化相关文件
app.*.symbols

# 代码混淆相关文件
app.*.map.json

# Android Studio 会在此保存构建产物
/android/app/debug
/android/app/profile
/android/app/release

# 组件预览相关文件
.widget_preview/

# 本地构建、打包产物及签名材料
/dist/
**/local.properties
**/*.keystore
**/*.jks

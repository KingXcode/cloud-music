// Runner 目标的应用级设置。
//
// 将来可能改为根据 pubspec.yaml 等元数据自动生成此文件。
// 如果未作替换，将其用作 'flutter create' 模板时，
// 下方配置值默认使用项目名称。

// 应用名称，默认也用作 Flutter 窗口标题。
PRODUCT_NAME = CloudMusic

// 应用的包标识符
PRODUCT_BUNDLE_IDENTIFIER = dev.cloudmusic.cloudMusic

// 应用信息中显示的版权声明
PRODUCT_COPYRIGHT = Copyright © 2026 dev.cloudmusic. All rights reserved.
